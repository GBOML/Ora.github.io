---
import HorizontalCard from './UI/HorizontalCard.astro';
import t from '../i18n/welcome-page.ts';
import presentation_model_light from "../assets/screenshots/light/presentation-model.png";
import presentation_model_dark from "../assets/screenshots/dark/presentation-model.png";
import presentation_result_light from "../assets/screenshots/light/presentation-result.png";
import presentation_result_dark from "../assets/screenshots/dark/presentation-result.png";
import presentation_report_light from "../assets/screenshots/light/presentation-report.png";
import presentation_report_dark from "../assets/screenshots/dark/presentation-report.png";

const cards = t.presentation.cards;
---

<section>
    <h2>
        {t.presentation.title}
    </h2>
    <p>
        {t.presentation.description}
    </p>
    <div class="card-container">
            <HorizontalCard
                icon="fa-regular fa-lightbulb"
                title={cards.model.title}
                content={cards.model.description}
                small={false}
                image={presentation_model_light}
                imageDark={presentation_model_dark}
                imagePosition="right"
            />
            <HorizontalCard
                icon="fa-solid fa-code-merge"
                title={cards.result.title}
                content={cards.result.description}
                small={false}
                image={presentation_result_light}
                imageDark={presentation_result_dark}
            />
            <HorizontalCard
                icon="fa-solid fa-microscope"
                title={cards.report.title}
                content={cards.report.description}
                small={false}
                image={presentation_report_light}
                imageDark={presentation_report_dark}
                imagePosition="right"
            />
    </div>
</section>

<style>
    section {
        background-color: var(--background-color);
        padding-bottom: 50px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 50px;
    }

    html.dark section {
        background-color: var(--background-color-dark);
    }

    h2 {
        font-size: 2rem;
        font-weight: bold;
        text-align: center;
    }
    
    .card-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 20px;
        justify-content: center;
        align-items: center;
    }

    @media (max-width: 1024px) {
        section {
            height: auto;
        }

        .card-container,
        .card-container:last-child {
            grid-template-columns: 1fr;
        }
    }
</style>