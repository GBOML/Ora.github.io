---
import Button from "./UI/Button.astro";
import t from "../i18n/contact-page.ts";
---

<form id="contact-form">
    <div class="form-grid">
        <div class="form-group">
            <label for="name">{t.form.name_input.label}</label>
            <input type="text" id="name" name="name" placeholder={t.form.name_input.placeholder} required />
        </div>
        <div class="form-group">
            <label for="email">{t.form.email_input.label}</label>
            <input type="email" id="email" name="email" placeholder={t.form.email_input.placeholder} required />
        </div>

        <div class="form-group">
            <label for="organisation">{t.form.organization_input.label}</label>
            <input type="text" id="organisation" name="organisation" placeholder={t.form.organization_input.placeholder} />
        </div>
        <div class="form-group">
            <label for="subject">{t.form.subject_input.label}</label>
            <input type="text" id="subject" name="subject" placeholder={t.form.subject_input.placeholder} />
        </div>
    </div>

    <div class="form-group full-width">
        <label for="message">{t.form.message_input.label}</label>
        <textarea id="message" name="message" placeholder={t.form.message_input.placeholder} required></textarea>
    </div>

    <div class="form-footer" style="justify-content: flex-end;">
            <p id="success-message" style="display: none; margin-right: 20px;"> {t.success_message} </p>
        <Button type="submit" arrowIcon={true} title="Send" basic={false} icon="fa-solid fa-arrow-right" iconPosition="right"/>
    </div>
</form>

<script>
    const form = document.getElementById('contact-form');
    const successMessage = document.getElementById('success-message');

    if (!(form instanceof HTMLFormElement) || !(successMessage instanceof HTMLElement)) {
        throw new Error("Unable to find form or success message element");
    }

    form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const formData = new FormData(form);

        const response = await fetch("http://formspree.io/f/xeebwpee", {
            method: "POST",
            body: formData,
            headers: {
                'Accept': 'application/json'
            },
        });

        if (response.ok) {
            successMessage.style.display = 'block';
            form.reset();
        } else {
            successMessage.style.display = 'none';
            alert('There was a problem submitting your form. Please try again.');
        }

    })
</script>

<style>
    #success-message {
        color: var(--success-color);
        letter-spacing: 0.5px;
    }

    html.dark #success-message {
        color: var(--success-color-dark);
    }

    form {
        background-color: var(--custom-white);
        border: 1px solid var(--border-color);
        border-radius: 24px;
        padding: 40px 50px 20px 50px;
        width: 100%;
        margin: 0 auto;
    }

    html.dark form {
        background-color: var(--custom-black);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
        margin-bottom: 32px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group.full-width {
        grid-column: 1 / -1;
    }

    input {
        padding: 12px 0;
        border-bottom: 1px solid var(--border-color);
        font-family: inherit;
        font-size: 1.2rem;
        color: var(--text-color);
        transition: color 0.3s ease;
    }

    html.dark input {
        color: var(--text-color-dark);
    }

    textarea {
        padding: 12px 16px;
        border: 1px solid var(--border-color);
        border-radius: 4px;
        font-size: 1rem;
        font-family: inherit;
        background-color: var(--custom-white);
        color: var(--text-color);
        transition: color 0.3s ease;
    }

    html.dark textarea {
        background-color: var(--custom-black);
        border: 1px solid var(--border-color-dark);
        color: var(--text-color-dark);
    }


    input:focus {
        outline: none;
        border-bottom: 1px solid var(--primary-color);
    }

    html.dark input:focus {
        border-bottom: 1px solid var(--primary-color-dark);
    }


    textarea:focus {
        outline: none;
        border: 1px solid var(--primary-color);
    }

    html.dark textarea:focus {
        border: 1px solid var(--primary-color-dark);
    }

    
    textarea {
        min-height: 200px;
        resize: vertical;
    }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
        padding-top: 24px;
    }
    
    input::placeholder,
    textarea::placeholder {
        color: var(--text-color);
        opacity: 0.6;
        /* transition: color 0.3s ease; */
    }
    
    html.dark input::placeholder,
    html.dark textarea::placeholder {
        color: var(--text-color-dark);
        opacity: 0.6;
    }


    .success-message {
        color: var(--text-important);
    }

    @media(max-width: 768px) {
        form {
            padding: 24px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 16px;
        }
    }
</style>