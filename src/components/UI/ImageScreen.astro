---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import default_logo from '../../assets/default.png';

interface Props {
    image?: ImageMetadata;
    imageDark?: ImageMetadata;
    imageAlt: string;
    height?: string;
    width?: string;
    contentHeight?: string;
}

const { image, imageDark, imageAlt, height, width, contentHeight } = Astro.props as Props;


---

<div class="container">
    <div class="header">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="image-wrapper" style={`height: ${contentHeight ?? "250px"}`}>
        <Image src={image ?? default_logo} alt={imageAlt} class="image" 
            style={`height: ${image ? '100%':  "80px"}; width: ${image ? '':  "80px"}; ${image ? 'object-fit: cover;' : ''}'`}
        />

        <Image src={imageDark ?? default_logo} alt={imageAlt} class="image-dark" 
            style={`height: ${imageDark ? '100%':  "80px"}; width: ${imageDark ? '':  "80px"}; ${imageDark ? 'object-fit: cover;' : ''}'`}
        />
    </div>
</div>

<style>
    .container {
        outline: 1px solid var(--border-color);
        background-color: var(--custom-white);
        width: 100%;
        border-radius: 24px;
        transition: outline 0.3s ease-in-out, box-shadow 0.3s ease-in-out, transform 0.3s ease-in-out;
        overflow: hidden;
        margin: auto;
    }

    html.dark .container {
        outline: 1px solid var(--border-color-dark);
        background-color: var(--custom-black);
    }

    .container:hover {
        box-shadow: 0 10px 10px var(--shadow-color);
        transform: scale(1.01)
    }

    html.dark .container:hover {
        box-shadow: 0 10px 10px var(--shadow-color-dark);
    }

    .header {
        background-color: var(--secondary-color);
        height: 32px;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 0 20px;
        z-index:10;
    }

    html.dark .header {
        background-color: var(--secondary-color-dark);
    }

    span {
        height: 8px;
        width: 8px;
        border-style: solid;
        border-width: 2px;
        border-radius: 50%;
        display: inline-block;
    }

    span:nth-child(1) {
        background-color: #ef3d4f;
        border-color: #ef3d4f;
    }

    span:nth-child(2) {
        background-color: #f8b53b;
        border-color: #f8b53b;
    }

    span:nth-child(3) {
        background-color: #2ed933;
        border-color: #2ed933;
    }

    .image-wrapper {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

    .image {
		padding: 4px;
		border-radius: 16px;
		overflow: hidden;
	}

    .image-dark {
        padding: 4px;
        border-radius: 16px;
        overflow: hidden;
        display: none;
    }

    html.dark .image {
        display: none;
    }

    html.dark .image-dark {
        display: block;
    }
</style>