---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import default_logo from '../../assets/default.png';

interface Props {
    image?: ImageMetadata;
    imageDark?: ImageMetadata;
    imageAlt: string;
    height?: string;
    width?: string;
    contentHeight?: string;
    mobileContentHeight?: string;
}

const { image, imageDark, imageAlt, height, width, contentHeight, mobileContentHeight } = Astro.props as Props;
---

<div class="container">
    <div class="header">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <div class="image-wrapper" 
    >
        <!-- style={`
            --desktop-height: ${contentHeight ?? "250px"}; 
            --mobile-height: ${mobileContentHeight ?? contentHeight ?? "250px"};`
        } -->

        <Image
            src={image ?? default_logo}
            alt={imageAlt}
            class="image"
            loading="eager"
            decoding="async"
        />

        <Image
            src={imageDark ?? default_logo}
            alt={imageAlt}
            class="image-dark"
            loading="eager"
            decoding="async"
        />
    </div>
</div>

<style>
    .container {
        outline: 1px solid var(--border-color);
        background-color: var(--custom-white);
        width: 100%;
        border-radius: 24px;
        transition:  box-shadow 0.3s ease-in-out, transform 0.3s ease-in-out;
        overflow: hidden;
        margin: auto;
    }

    html.dark .container {
        outline: 1px solid var(--border-color-dark);
        background-color: var(--custom-black);
    }

    .container:hover {
        box-shadow: 0 10px 10px var(--shadow-color);
        transform: scale(1.01)
    }

    html.dark .container:hover {
        box-shadow: 0 10px 10px var(--shadow-color-dark);
    }

    .header {
        background-color: var(--secondary-color);
        height: 32px;
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 0 20px;
        z-index:10;
    }

    html.dark .header {
        background-color: var(--secondary-color-dark);
    }

    span {
        height: 8px;
        width: 8px;
        border-style: solid;
        border-width: 2px;
        border-radius: 50%;
        display: inline-block;
    }

    span:nth-child(1) {
        background-color: #ef3d4f;
        border-color: #ef3d4f;
    }

    span:nth-child(2) {
        background-color: #f8b53b;
        border-color: #f8b53b;
    }

    span:nth-child(3) {
        background-color: #2ed933;
        border-color: #2ed933;
    }

    .image-wrapper {
        position: relative;
        width: 100%;
    }

    .image,
    .image-dark {
        display: block;
        width: 100%;
        height: auto;

        padding: 4px;
        box-sizing: border-box;
        border-radius: 16px;
    }

    .image {
        opacity: 1;
    }

    .image-dark {
        opacity: 0;
        position: absolute;
        inset: 0;
    }

    html.dark .image {
        opacity: 0;
    }

    html.dark .image-dark {
        opacity: 1;
    }
</style>