---
import Button from "./UI/Button.astro";
import sharedLink from '../assets/shared_link.json';
---

<section>
    <div class="contact-us-container">
        <h2>Ready to try ?</h2>

        <p>Voluptate amet minim Lorem qui est ipsum consectetur est pariatur. Et ullamco sint cupidatat consectetur officia nostrud.</p>

        <div class="button-container">
            <Button title="Contact us" basic={false} href={`/${sharedLink.base}/contact`} small={true}/>
        </div>
    </div>
</section>

<style>
    section {
        min-height : auto;
        padding-top: 10px; 
        padding-bottom: 100px; 
    }

    .contact-us-container {
        outline: 1px solid rgb(from var(--primary-color) r g b / 0.2);
        background-color: rgb(from var(--primary-color) r g b / 0.05);
        border-radius: 24px;
        padding: 40px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 20px;
        width: 90%;
        margin: auto
    }

    html.dark .contact-us-container {
        outline: 1px solid rgb(from var(--primary-color-dark) r g b / 0.2);
        background-color: rgb(from var(--primary-color-dark) r g b / 0.05);
    }

    
    h2 {
        font-size: 1.8rem;
        font-weight: bold;
    }

    p {
		color: var(--text-color-secondary);
		font-size: 1rem;
        max-width: 50%;
        text-align: center;
	}

    html.dark p {
		color: var(--text-color-secondary-dark);
	}


    .button-container {
        display: flex;
        gap: 20px;
    }

    @media (max-width: 1024px) {
        section {
            padding-bottom: 50px; 
        }


        .contact-us-container {
            width: 100%;
            padding: 20px;
        }

        p {
            max-width: 100%;
        }
    }
</style>