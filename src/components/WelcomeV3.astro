---
import Badge from "./UI/Badge.astro";
import Button from "./UI/Button.astro";
import ImageScreen from "./UI/ImageScreen.astro";
import default_logo from '../assets/default.png';
import t from '../i18n/welcome-page.ts';
import sharedLink from '../assets/shared_link.json';
---

<section id="welcome">
	<div class="welcome-container">
		<div class="text-container">
			<Badge text="New V1.0"/>
			<h1>
				{t.welcome.titleBefore} <em>{t.welcome.titleHighlight}</em>

			</h1>

			<p>{t.welcome.description}</p>

			<div class="button-container">
				<Button title="See documentation" icon="fa-solid fa-newspaper" />
				<Button title="Contact us" icon="fa-solid fa-envelope" basic={false} href={`/${sharedLink.base}/contact`} internal_link={true}/>
			</div>
		</div>
	
		<div class="image-container">
			<div class="image-left">
				<span>
					<ImageScreen 
						image={default_logo}
						imageAlt="Feature 1"
						contentHeight={"calc(80vh / 2 - 20px)"}
					/>
				</span>

				<span>
					<ImageScreen 
						image={default_logo}
						imageAlt="Feature 1"
						contentHeight={"calc(80vh / 2 - 30px)"}
					/>
				</span>
			</div>

			<span>
				<ImageScreen 
					image={default_logo}
					imageAlt="Feature 1"
					contentHeight={"calc(80vh - 40px)"}
				/>
			</span>

		</div>
	</div>
</section>

<style>
	#welcome {
		background: radial-gradient(circle, rgb(from var(--primary-color) r g b / 0.3) 0%, var(--background-color) 40%);
		padding-bottom: 80px;
		min-height: 100vh;
		height: 100%;
	}

	html.dark #welcome {
		background: radial-gradient(circle, rgb(from var(--primary-color-dark) r g b / 0.3) 0%, var(--background-color-dark) 40%);
	}

	.welcome-container {
		height: 100%;
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
	}

	.text-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		justify-content: center;
		gap: 24px;
		max-width: 50%;
		margin: auto;
	}

	h1 {
		font-size: 4.5rem;
		margin: 0;
		line-height: 1;
	}

	p {
		color: var(--text-color-secondary);
		font-size: 1.2rem;
	}

	html.dark p {
		color: var(--text-color-secondary-dark);
	}

	.button-container {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.image-container {
		width: 50%;
		display: grid;
		grid-template-columns: 1.5fr 1.2fr;
		gap: 20px;
		align-items: center;
		position: relative;
	}

	.image-left {
		display: flex;
		flex-direction: column;
		gap: 20px;
		width: 100%;
	}

	.image-left span {
		width: 110%;
		transform: translateX(50px);
	}

	.image-container > span {
		width: 120%;
		z-index: 10;
	}

	@media (max-width: 1024px) {
		.welcome-container {
			flex-direction: column;
			gap: 40px;
		}

		h1 {
			font-size: 2.5rem;
		}

		.image-container {
			height: 200px;
		}

		.button-container {
			flex-direction: column;
			gap: 12px;
		}
	}

</style>