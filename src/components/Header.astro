---
const currentPath = Astro.url.pathname;
import sharedLink from '../assets/shared_link.json';
import ThemeToggle from './UI/ThemeToggle.astro';
---

<header>
    <h1>
        <a href={`/${sharedLink.base}`}>Ora</a>
    </h1>
    

    <nav>
        <ul>
            <li><a href={`/${sharedLink.base}`} class={currentPath === `/${sharedLink.base}` ? 'active' : ''}>Home</a></li>
            <li><a href={`/${sharedLink.base}/functionalities`} class={currentPath === `/${sharedLink.base}/functionalities` ? 'active' : ''}>Functionalities</a></li>
            <li><a href={`/${sharedLink.base}/team`} class={currentPath === `/${sharedLink.base}/team` ? 'active' : ''}>Team</a></li>
            <li><a href={`/${sharedLink.base}/contact`} class={currentPath === `/${sharedLink.base}/contact` ? 'active' : ''}>Contact</a></li>
        </ul>
    </nav>

    <ThemeToggle />
</header>

<script>
    let lastScrollTop = 0;
    const header = document.querySelector('header');

    // Hide/show header au scroll
    window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;
        
        if (scrollTop > lastScrollTop && scrollTop > 100) {
            header?.classList.add('hide-header');
        } else {
            header?.classList.remove('hide-header');
        }
        
        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    });
</script>

<style>
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: fixed;
        top: 0;
        width: 100%;
        background-color: var(--custom-white);
        box-shadow: 0 2px 4px var(--shadow-color);
        padding-top: 10px;
        padding-bottom: 10px;
        transition: transform 0.3s ease-in-out;
        z-index: 1000;
    }

   
    html.dark header {
        background-color: var(--custom-black);
        box-shadow: 0 2px 4px var(--shadow-color-dark);
    }


    header.hide-header {
        transform: translateY(-100%);
    }

    h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
    }

    ul {
        list-style: none;
        display: flex;
        gap: 20px;
        padding: 0;
        margin: 0;
        font-size: 1rem;
        font-weight: 500;
    }

     li > a {
        position: relative;
    }

    li > a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1.5px;
        background: var(--primary-color);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease-in-out;
    }

    html.dark li > a::after {
        background: var(--primary-color-dark);
    }


    li > a:hover,
    li > a.active {
        color: var(--primary-color);
    }

    html.dark li > a:hover,
    html.dark li > a.active {
        color: var(--primary-color-dark);
    }

    li > a:hover::after,
    li > a.active::after {
        transform: scaleX(1);
    }
</style>