---
const currentPath = Astro.url.pathname;
import sharedLink from '../assets/shared_link.json';
import ThemeToggle from './UI/ThemeToggle.astro';

export const links = [
    { name: 'Home', href: `/${sharedLink.base}` },
    // { name: 'Functionalities', href: `/${sharedLink.base}/functionalities` },
    // { name: 'Team', href: `/${sharedLink.base}/team` },
    { name: 'Contact', href: `/${sharedLink.base}/contact` },
];
---

<header>
    <button class="menu-button" aria-label="Toggle navigation menu" aria-expanded="false">
        <i class="fa-solid fa-bars"></i>
        <i class="fa-solid fa-xmark"></i>
    </button>

    <h1>
        <a href={`/${sharedLink.base}`}>Ora</a>
    </h1>
    
    <nav id="mobile-menu" class="mobile-menu">
        <ul>
            {links.map(link => (
                <li>
                    <a href={link.href} class={currentPath === link.href ? 'active' : ''}>{link.name}</a>
                </li>
            ))}
        </ul>

        <div class="theme-toggle-mobile">
            <ThemeToggle />
        </div>
    </nav>

    <nav class="desktop-nav">
        <ul>
            {links.map(link => (
                <li>
                    <a href={link.href} class={currentPath === link.href ? 'active' : ''}>{link.name}</a>
                </li>
            ))}
        </ul>
    </nav>

    <div class="theme-toggle-desktop">
        <ThemeToggle />
    </div>
</header>

<script>
    let lastScrollTop = 0;
    const header = document.querySelector('header');
    const menuButton = document.querySelector('.menu-button');
    const mobileMenu = document.getElementById('mobile-menu');

    const closeMobileMenu = () => {
        menuButton?.classList.remove('active');
        menuButton?.setAttribute('aria-expanded', 'false');
        mobileMenu?.classList.remove('show');
    };

    const openMobileMenu = () => {
        menuButton?.classList.add('active');
        menuButton?.setAttribute('aria-expanded', 'true');
        mobileMenu?.classList.add('show');
    };

    menuButton?.addEventListener('click', () => {
        const isOpen = mobileMenu?.classList.contains('show');

        if (isOpen) {
            closeMobileMenu();
        } else {
            openMobileMenu();
        }
    });

    const mobileMenuLinks = document.querySelectorAll('.mobile-menu a');

    mobileMenuLinks.forEach(link => {
        link.addEventListener('click', closeMobileMenu);
    });

    window.addEventListener('scroll', () => {
        const scrollTop = window.scrollY;

        if (scrollTop > lastScrollTop && scrollTop > 50) {
            header?.classList.add('hide-header');

            closeMobileMenu();
        } else {
            header?.classList.remove('hide-header');
        }

        lastScrollTop = scrollTop <= 0 ? 0 : scrollTop;
    });
</script>

<style>
    header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: fixed;
        top: 0;
        width: 100%;
        background-color: var(--custom-white);
        box-shadow: 0 2px 4px var(--shadow-color);
        padding-top: 10px;
        padding-bottom: 10px;
        transition: transform 0.3s ease-in-out;
        z-index: 1000;
    }

    html.dark header {
        background-color: var(--custom-black);
        box-shadow: 0 2px 4px var(--shadow-color-dark);
    }

    .menu-button {
        display: none;
        flex-direction: column;
        background: none;
        border: none;
        cursor: pointer;
        padding: 0;
        color: var(--text-color);
        font-size: 1.5rem;
    }

    html.dark .menu-button {
        color: var(--text-color-dark);
    }

    .menu-button i {
        width: 24px;
        transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .menu-button i:nth-child(2) {
        display: none;
    }

    .menu-button.active i:nth-child(1) {
        display: none;
    }

    .menu-button.active i:nth-child(2) {
        display: block;
    }

    header.hide-header {
        transform: translateY(-100%);
    }

    .desktop-nav {
        display: flex;
    }

    .mobile-menu {
        font-size: 0.7rem;
        display: flex;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background-color: var(--secondary-color);
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 0 30px;
        max-height: 0;
        opacity: 0;
        overflow: hidden;
        visibility: hidden;
        border-top: 1px solid transparent;
        transition:
            max-height 0.3s ease-in-out,
            opacity 0.2s ease-in-out,
            padding 0.3s ease-in-out,
            border-color 0.3s ease-in-out,
            visibility 0s linear 0.3s;
    }

    html.dark .mobile-menu {
        background-color: var(--secondary-color-dark);
    }

    .mobile-menu.show {
        max-height: 200px;
        opacity: 1;
        visibility: visible;
        padding: 10px 30px;
        border-top: 1px solid var(--border-color);
        transition:
            max-height 0.3s ease-in-out,
            opacity 0.2s ease-in-out,
            padding 0.3s ease-in-out,
            border-color 0.3s ease-in-out,
            visibility 0s linear 0s;
    }

    html.dark .mobile-menu.show {
        border-top-color: var(--border-color-dark);
    }

    .mobile-menu ul {
        flex-direction: column;
        gap: 15px;
    }

    h1 {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
    }

    ul {
        list-style: none;
        display: flex;
        gap: 40px;
        padding: 0;
        margin: 0;
        font-size: 1rem;
        font-weight: 500;
    }

    li > a {
        position: relative;
    }

    li > a::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -4px;
        width: 100%;
        height: 1.5px;
        background: var(--primary-color);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 0.3s ease-in-out;
    }

    html.dark li > a::after {
        background: var(--primary-color-dark);
    }

    li > a:hover,
    li > a.active {
        color: var(--primary-color);
    }

    html.dark li > a:hover,
    html.dark li > a.active {
        color: var(--primary-color-dark);
    }

    li > a:hover::after,
    li > a.active::after {
        transform: scaleX(1);
    }

    .theme-toggle-mobile {
        display: none;
        margin-top: 1rem;
    }

    .theme-toggle-desktop {
        display: block;
    }

    @media (max-width: 1024px) {
        header {
            display: grid;
            grid-template-columns: 1fr auto 1fr;
            align-items: center;
        }

        .menu-button {
            display: flex;
            order: -1;
        }

        .desktop-nav {
            display: none;
        }

        .mobile-menu {
            display: flex;
        }

        .theme-toggle-desktop {
            display: none;
        }

        .theme-toggle-mobile {
            display: flex;
            justify-content: center;
        }
    }
</style>