---
import PageHeader from '../components/PageHeader.astro';
import t from "../i18n/functionalities-page.ts";
import functionalities_model_light from "../assets/screenshots/light/functionalities-model.png";
import functionalities_model_dark from "../assets/screenshots/dark/functionalities-model.png";
import functionalities_space_light from "../assets/screenshots/light/functionalities-space.png";
import functionalities_space_dark from "../assets/screenshots/dark/functionalities-space.png";
import functionalities_report_light from "../assets/screenshots/light/functionalities-report.png";
import functionalities_report_dark from "../assets/screenshots/dark/functionalities-report.png";
import ImageLightDark from './UI/ImageLightDark.astro';
---

<section id="#functionnalities">
    <PageHeader 
        title={t.header.title}
        description={t.header.description}
    />

   
    <!-- Model Section -->
    <div class="wrapper">
        <div>
            <h2 class="mb-5">
                <i class="fa-solid fa-code-merge"></i>
                {t.model_section.title}
            </h2>

            <p class="mb-3">{t.model_section.description}</p>
            <ul>
                {t.model_section.keys.map((key, i) => {
                    return (
                        <li class="mb-2">
                            <span>
                                <i class="fa-solid fa-check"></i>
                            </span>
                            <em class="mr-2">{key.title}</em>{key.description}
                        </li>
                    )
                    
                })}
            </ul>
        </div>

        <span class="flex justify-center">
             <ImageLightDark image={functionalities_model_light} imageDark={functionalities_model_dark} height={400} imageAlt="data node"/>
        </span>
    </div>

    <!-- Space section -->
    <div class="wrapper">
        <span class="flex justify-center">
            <ImageLightDark image={functionalities_space_light} imageDark={functionalities_space_dark} height={400} imageAlt="space"/>
        </span>

        <div>
            <h2 class="mb-5">
                <i class="fa-solid fa-code-merge"></i>
                {t.space_section.title}
            </h2>

            <p class="mb-3">{t.space_section.description}</p>
            <ul>
                {t.space_section.keys.map((key, i) => {
                    return (
                        <li class="mb-2">
                            <span>
                                <i class="fa-solid fa-check"></i>
                            </span>
                            <em class="mr-2">{key.title}</em>{key.description}
                        </li>
                    )
                    
                })}
            </ul>
        </div>
    </div>

     <!-- Report section -->
    <div class="wrapper">
        <div>
            <h2 class="mb-5">
                <i class="fa-solid fa-code-merge"></i>
                {t.report_section.title}
            </h2>

            <p class="mb-3">{t.report_section.description}</p>
            <ul>
                {t.report_section.keys.map((key, i) => {
                    return (
                        <li class="mb-2">
                            <span>
                                <i class="fa-solid fa-check"></i>
                            </span>
                            <em class="mr-2">{key.title}</em>{key.description}
                        </li>
                    )
                    
                })}
            </ul>
        </div>

        <span class="flex justify-center">
            <ImageLightDark image={functionalities_report_light} imageDark={functionalities_report_dark} height={400} imageAlt="report"/>
        </span>
    </div>
</section>

<style>
    section {
        background-color: var(--background-color);
        padding-bottom: 50px;
    }

    html.dark section {
        background-color: var(--background-color-dark);
    }

    .wrapper {
        display: grid;
        grid-template-columns: 1.5fr 2.5fr;
        grid-template-rows: repeat(2, auto);
        gap: 50px;
        align-items: center;
    }

    .wrapper:nth-child(even) {
        grid-template-columns: 2.5fr 1.5fr;
    }

    .wrapper h2 {
        font-size: 2rem;
        font-weight: bold;
        color: var(--primary-color);        
    }

    html.dark .wrapper h2 {
        color: var(--primary-color-dark);
    }

    .wrapper .image {
        object-fit: cover;
    }

    .section-content {
        display: flex;
        flex-direction: column;
        gap: 60px;
    }

    .cards-container {
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    li > span {
        color: var(--primary-color);
    }

    h2 > i,
    li > span {
        margin-right: 10px;
    }

    html.dark li > span {
        color: var(--primary-color-dark);
    }

    @media (max-width: 1024px) {
        .wrapper,
        .wrapper:nth-child(even) {
            grid-template-columns: 1fr;
            gap: 20px;
            margin-bottom: 50px;
        }

        .wrapper:nth-child(odd) > span {
            order: 2;
        }

    }
</style>