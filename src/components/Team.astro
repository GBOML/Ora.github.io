---
import VerticalCard from './UI/VerticalCard.astro';
import t from "../i18n/team-page.ts";
---

<div class="section-content">
    {t.team.map((member, i) => {
        return (
            <VerticalCard
                title={member.name}
                subtitle={member.role}
                content={member.description}
                image={member.image}
                links={member.links}
            />
        )
    })}
</div>

<style>
    .section-content {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--grid-gap-container);
    }
</style>