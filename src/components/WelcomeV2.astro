---
import Badge from "./UI/Badge.astro";
import Button from "./UI/Button.astro";
import ImageScreen from "./UI/ImageScreen.astro";
import model_view_light from "../assets/screenshots/light/model-view.png";
import model_view_dark from "../assets/screenshots/dark/model-view.png";
import space_view_light from "../assets/screenshots/light/space-view.png";
import space_view_dark from "../assets/screenshots/dark/space-view.png";
import report_view_light from "../assets/screenshots/light/report-view.png";
import report_view_dark from "../assets/screenshots/dark/report-view.png";
import t from '../i18n/welcome-page.ts';
import sharedLink from '../assets/shared_link.json';
---

<section id="welcome">
	<div class="welcome-container">
		<div class="text-container">
			<Badge text="New V1.0"/>
			<h1>
				{t.welcome.titleBefore} <em>{t.welcome.titleHighlight}</em>
			</h1>

			<p>{t.welcome.description}</p>

			<div class="button-container">
				<!-- <Button title="See documentation" icon="fa-solid fa-newspaper" /> -->
				<Button title="Contact us" icon="fa-solid fa-envelope" basic={false} href={`/${sharedLink.base}/contact`} internal_link={true}/>
			</div>
		</div>
	
		<div class="image-container">
			<div class="image-left">
				<span>
					<ImageScreen
						image={space_view_light}
						imageDark={space_view_dark}
						imageAlt="Feature 1"
						contentHeight={"calc(80vh / 2 - 20px)"}
						mobileContentHeight={"calc(80vh / 2 - 100px)"}
					/>
				</span>

				<span>
					<ImageScreen 
						image={report_view_light}
						imageDark={report_view_dark}
						imageAlt="Feature 1"
						contentHeight={"calc(80vh / 2 - 30px)"}
						mobileContentHeight={"calc(80vh / 2 - 100px)"}
					/>
				</span>
			</div>

			<span>
				<ImageScreen 
					image={model_view_light}
					imageDark={model_view_dark}
					imageAlt="Feature 1"
					contentHeight={"calc(80vh - 40px)"}
					mobileContentHeight={"calc(80vh / 2 - 100px)"}
				/>
			</span>
		</div>
	</div>
</section>

<style>
	#welcome {
		background: radial-gradient(circle, rgb(from var(--primary-color) r g b / 0.3) 0%, var(--background-color) 55%);
		min-height: 100%;
		height: auto;
	}

	html.dark #welcome {
		background: radial-gradient(circle, rgb(from var(--primary-color-dark) r g b / 0.3) 0%, var(--background-color-dark) 55%);
	}

	.welcome-container {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 40px;
	}

	.text-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		justify-content: center;
		gap: 24px;
		max-width: 50%;
		margin: auto;
	}

	h1 {
		font-size: 4.5rem;
		margin: 0;
		line-height: 1;
	}

	p {
		color: var(--text-color-secondary);
		font-size: 1.2rem;
	}

	html.dark p {
		color: var(--text-color-secondary-dark);
	}

	.button-container {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.image-container {
		width: 100%;
		display: grid;
		grid-template-columns: 1.5fr 1.2fr;
		gap: 20px;
		align-items: center;
		position: relative;
	}

	.image-left {
		display: flex;
		flex-direction: column;
		gap: 20px;
		width: 100%;
	}

	.image-left span {
		width: 100%;
		transform: translateX(80px);
	}

	.image-container > span {
		width: 100%;
		transform: translateX(-80px);
		z-index: 10;
	}

	@media (max-width: 1024px) {
		h1 {
			font-size: 3.5rem;
		}

		.text-container {
			max-width: 100%;
		}

		.button-container {
			flex-direction: column;
			gap: 12px;
		}

		.image-left span,
		.image-container > span {
	        transform: none;
        	width: 100%;
		}


		.image-container {
			display: flex;
			flex-direction: column;
			align-items: center;
			gap: 0;
		}

		.image-left {
			width: 100%;
			gap: 0;
		}

		.image-left span {
			margin-bottom: 20px;
		}
	}
</style>