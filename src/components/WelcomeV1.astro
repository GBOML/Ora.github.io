---
import Badge from "./UI/Badge.astro";
import Button from "./UI/Button.astro";
import ImageScreen from "./UI/ImageScreen.astro";
import welcome_model_light from "../assets/screenshots/light/welcome-model.png";
import welcome_model_dark from "../assets/screenshots/dark/welcome-model.png";
import t from '../i18n/welcome-page.ts';
import sharedLink from '../assets/shared_link.json';
---

<section id="welcome">
	<div class="welcome-container">
		<div class="text-container">
			<Badge text="New V1.0"/>
			<div class="text-content">
				<h1>
					{t.welcome.titleBefore} <em>{t.welcome.titleHighlight}</em>
				</h1>
				
				<p>{t.welcome.description}</p>
			</div>

			<div class="button-container">
				<!-- <Button title="See documentation" icon="fa-solid fa-newspaper" /> -->
				<Button title="Contact us" icon="fa-solid fa-envelope" basic={false} href={`/${sharedLink.base}/contact`} internal_link={true}/>
			</div>
		</div>
	
		<div class="image-container">
			<ImageScreen 
				image={welcome_model_light}
				imageDark={welcome_model_dark}
				imageAlt="Model view"
				/>
		</div>
	</div>
</section>

<style>
	#welcome {
		height: 100vh;
		box-sizing: border-box;
		padding-bottom: 50px;
	}

	.welcome-container {
		height: 100%;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
	}

	.text-container {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		justify-content: center;
		gap: 24px;
	}

	.text-content {
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 12px;
	}

	h1 {
		font-size: 4.5rem;
		margin: 0;
		line-height: 1;
	}

	p {
		color: var(--text-color-secondary);
		font-size: 1.2rem;
		width: 60%;
	}

	html.dark p {
		color: var(--text-color-secondary-dark);
	}

	.button-container {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.image-container {
		width: 50%;
		max-height: 900px;
	}

	@media (max-width: 1024px) {
		.welcome-container {
			justify-content: center;
			gap: 6vh;
		}

		.text-container {
			max-width: 100%;
		}

		.text-content {
			gap: 12px;
		}

		h1 {
			font-size: 2.5rem;
		}

		p {
			width: 90%;
		}

		.button-container {
			flex-direction: column;
			gap: 12px;
		}

		.image-container {
			width: 100%;
		}
	}
</style>