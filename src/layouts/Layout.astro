---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import "../style/global.css";
import sharedLink from '../assets/shared_link.json';

const isHomePage = Astro.url.pathname === `/${sharedLink.base}/`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="stylesheet"
			href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"
		/>
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Ora</title>
		
		<script is:inline>
			const theme = localStorage.getItem("theme");

			if (
				theme === "dark" ||
				(!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)
				) {
				document.documentElement.classList.add("dark");
			}
		</script>

	</head>
	
	<body class:list={{ "home-page": isHomePage }}>
		<Header />

		<slot />

		<Footer />
	</body>
</html>

<style>
	html,
	body {
    	font-size: var(--font-size);
		margin: auto;
		height: 100%;
		color: var(--text-color);
		background-color: var(--background-color);
		scroll-behavior: smooth;
	}

	html.dark,
	html.dark body {
		color: var(--text-color-dark);
		background-color: var(--custom-black);
	}

	body.home-page {
		position: relative;
		isolation: isolate;
	}

	body.home-page::before {
		content: "";
		position: absolute;
		inset: 0 0 auto 0;
		height: 1000px;

		background: radial-gradient(
			circle at 50% 30%,
			rgb(from var(--primary-color) r g b / 0.3) 0%,
			var(--background-color) 50%
		);

		z-index: -1;
		pointer-events: none;
	}

	html.dark body.home-page::before {
		background: radial-gradient(
			circle at 50% 30%,
			rgb(from var(--primary-color-dark) r g b / 0.3) 0%,
			var(--background-color-dark) 55%
		);
	}

	@media (max-width: 1024px) {
		html,
		body {
			font-size: var(--font-size-small);
		}
	}
</style>